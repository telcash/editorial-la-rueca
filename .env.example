# Supabase

NEXT_PUBLIC_SUPABASE_URL=

# Publishable key publica del proyecto Supabase para clientes SSR/browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Fallback historico soportado durante la migracion de nombres.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave privada solo para procesos server/CLI controlados de migracion.
# Nunca exponer al cliente ni usar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Database

# Transaction Pooler, normalmente puerto 6543, para runtime serverless.
DATABASE_URL=

# Conexion directa o Session Pooler, normalmente puerto 5432, para migraciones.
DATABASE_MIGRATION_URL=

# Site

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP / SiteGround

# Host SMTP proporcionado por SiteGround.
SMTP_HOST=

# Puerto SMTP. Configuraciones habituales: 465 con SMTP_SECURE=true o 587 con SMTP_SECURE=false.
SMTP_PORT=

# true para TLS directo, false para STARTTLS cuando el proveedor lo indique.
SMTP_SECURE=

# Usuario SMTP de la cuenta de correo corporativa.
SMTP_USER=

# Password SMTP. No usar secretos reales en este archivo.
SMTP_PASSWORD=

# Dirección remitente corporativa para notificaciones internas.
CONTACT_NOTIFICATION_FROM=

# Destinatario interno de las solicitudes web.
CONTACT_NOTIFICATION_TO=
